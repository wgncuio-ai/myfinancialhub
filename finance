                    {fmtRM(amt)}{b > 0 && <span style={{ color: T.muted }}> / {fmtRM(b)}</span>}
                  </span>
                </div>
                <Bar pct={b > 0 ? (amt / b) * 100 : (amt / maxCat) * 100} over={over} />
