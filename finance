<script type="text/babel" data-presets="react">
const { useState, useEffect, useMemo, useCallback } = React;

// --- Icon shim: renders lucide icon data as an inline SVG React element ---
function Icon({ name, size = 16, color = "currentColor", style }) {
  const data = window.lucide && window.lucide.icons ? window.lucide.icons[name] : null;
  if (!data) {
    // fallback: empty box so layout doesn't break if an icon name is missing
    return React.createElement("svg", { width: size, height: size, style });
  }
  // lucide icon data is [tag, attrs, children?] node arrays
  const toEl = (node, key) => {
    const [tag, attrs, children] = node;
    return React.createElement(tag, { ...attrs, key },
      Array.isArray(children) ? children.map((c, i) => toEl(c, i)) : null);
  };
  const children = data.map ? data.map((n, i) => toEl(n, i)) : [];
  return React.createElement("svg", {
    xmlns: "http://www.w3.org/2000/svg", width: size, height: size,
    viewBox: "0 0 24 24", fill: "none", stroke: color, strokeWidth: 2,
    strokeLinecap: "round", strokeLinejoin: "round", style,
  }, children);
}


// ---------- Design tokens ----------
const T = {
  pine: "#123B2A",
  pineMid: "#1D5C42",
  pineSoft: "#EAF1EC",
  paper: "#F2F4F0",
  card: "#FFFFFF",
  ink: "#1C2B24",
  muted: "#6B7A72",
  line: "#E2E6E0",
  amber: "#B97E12",
  amberSoft: "#FBF3E2",
  red: "#B3372E",
  redSoft: "#F9ECEA",
  mono: "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace",
};

const STORAGE_KEY = "family-finance-v1";

function thisMonthConst() { return new Date().toISOString().slice(0, 7); }

const DEFAULT_CATEGORIES = [
  "Groceries", "Dining Out", "Transport & Fuel", "Utilities & Bills",
  "Kids & Education", "Health & Insurance", "Shopping", "Household",
  "Entertainment", "Travel", "Giving & Family", "Others",
];

const DEFAULT_DATA = {
  transactions: [],
  budgets: {},
  goals: [],
  assets: [],
  liabilities: [],
  loans: [],
  snapshots: [],
  pool: { topup: 0, startMonth: thisMonthConst(), entries: [] },
  cards: ["Credit Card 1", "Cash / Debit"],
  categories: DEFAULT_CATEGORIES,
};

const PERSONAL_CATEGORIES = [
  "Dining & Coffee", "Transport & Fuel", "Shopping & Personal",
  "Health & Grooming", "Hobbies", "Subscriptions", "Aquascaping",
  "Side Venture", "Gifts", "Others",
];

const WORKSPACES = [
  { id: "family", label: "Family", eyebrow: "Goh Family Ledger", accent: "#123B2A" },
  { id: "personal", label: "Personal", eyebrow: "William · Personal Ledger", accent: "#3B2A6B" },
];

const makeDefault = (wsId) =>
  wsId === "personal"
    ? { ...structuredClone(DEFAULT_DATA), categories: PERSONAL_CATEGORIES, cards: ["Personal card", "Cash"] }
    : structuredClone(DEFAULT_DATA);

// ---------- Helpers ----------
const fmtRM = (n) =>
  "RM " + (Number(n) || 0).toLocaleString("en-MY", { minimumFractionDigits: 2, maximumFractionDigits: 2 });

const thisMonth = () => new Date().toISOString().slice(0, 7);
const todayStr = () => new Date().toISOString().slice(0, 10);
const uid = () => Date.now().toString(36) + Math.random().toString(36).slice(2, 7);

const monthLabel = (ym) => {
  if (!ym) return "";
  const [y, m] = ym.split("-");
  const names = ["Jan","Feb","Mar","Apr","May","Jun","Jul","Aug","Sep","Oct","Nov","Dec"];
  return `${names[parseInt(m, 10) - 1]} ${y}`;
};

const parseDate = (raw) => {
  const s = (raw || "").trim();
  let m = s.match(/^(\d{4})-(\d{1,2})-(\d{1,2})$/);
  if (m) return `${m[1]}-${m[2].padStart(2, "0")}-${m[3].padStart(2, "0")}`;
  m = s.match(/^(\d{1,2})[\/\-.](\d{1,2})[\/\-.](\d{4})$/);
  if (m) return `${m[3]}-${m[2].padStart(2, "0")}-${m[1].padStart(2, "0")}`;
  m = s.match(/^(\d{1,2})[\/\-.](\d{1,2})[\/\-.](\d{2})$/);
  if (m) return `20${m[3]}-${m[2].padStart(2, "0")}-${m[1].padStart(2, "0")}`;
  return null;
};

const parseAmount = (raw) => {
  const cleaned = (raw || "").replace(/rm/i, "").replace(/,/g, "").trim();
  const n = parseFloat(cleaned);
  return isNaN(n) ? null : Math.abs(n);
};

// ---------- Small UI atoms ----------
const Card = ({ children, style }) => (
  <div
    style={{
      background: T.card, border: `1px solid ${T.line}`, borderRadius: 10,
      padding: 16, ...style,
    }}
  >
    {children}
  </div>
);

const Eyebrow = ({ children }) => (
  <div style={{
    fontSize: 11, letterSpacing: "0.08em", textTransform: "uppercase",
    color: T.muted, fontWeight: 600, marginBottom: 6,
  }}>{children}</div>
);

const MonoNum = ({ children, size = 22, color = T.ink, weight = 600 }) => (
  <div style={{ fontFamily: T.mono, fontSize: size, color, fontWeight: weight, fontVariantNumeric: "tabular-nums" }}>
    {children}
  </div>
);

const Btn = ({ children, onClick, kind = "primary", small, disabled, type }) => {
  const styles = {
    primary: { background: T.pine, color: "#fff", border: `1px solid ${T.pine}` },
    ghost: { background: "transparent", color: T.pine, border: `1px solid ${T.line}` },
    danger: { background: "transparent", color: T.red, border: "1px solid transparent" },
  }[kind];
  return (
    <button
      type={type || "button"}
      onClick={onClick}
      disabled={disabled}
      style={{
        ...styles, borderRadius: 8, cursor: disabled ? "not-allowed" : "pointer",
        padding: small ? "5px 10px" : "9px 16px", fontSize: small ? 12.5 : 14,
        fontWeight: 600, display: "inline-flex", alignItems: "center", gap: 6,
        opacity: disabled ? 0.5 : 1,
      }}
    >
      {children}
    </button>
  );
};

const inputStyle = {
  border: `1px solid ${T.line}`, borderRadius: 8, padding: "8px 10px",
  fontSize: 14, color: T.ink, background: "#fff", outline: "none", width: "100%",
};

const Field = ({ label, children }) => (
  <label style={{ display: "block", flex: 1, minWidth: 130 }}>
    <div style={{ fontSize: 12, color: T.muted, marginBottom: 4, fontWeight: 600 }}>{label}</div>
    {children}
  </label>
);

const Bar = ({ pct, over }) => (
  <div style={{ height: 8, background: T.pineSoft, borderRadius: 99, overflow: "hidden" }}>
    <div style={{
      height: "100%", width: `${Math.min(pct, 100)}%`,
      background: over ? T.red : T.pineMid, borderRadius: 99,
      transition: "width 0.4s ease",
    }} />
  </div>
);

// Rebuild the pool passbook (auto top-ups + manual entries) for export — mirrors the Pool tab
function buildPoolLedger(pool) {
  if (!pool) return [];
  const rows = [];
  const topup = Number(pool.topup) || 0;
  if (topup > 0 && pool.startMonth) {
    let [y, m] = pool.startMonth.split("-").map(Number);
    const [cy, cm] = thisMonthConst().split("-").map(Number);
    let guard = 0;
    while ((y < cy || (y === cy && m <= cm)) && guard < 600) {
      const ym = `${y}-${String(m).padStart(2, "0")}`;
      if (!(pool.skipTopups || []).includes(ym)) {
        rows.push({ id: `topup-${ym}`, date: `${ym}-01`, type: "topup", desc: "Monthly top-up", amount: topup });
      }
      m++; if (m > 12) { m = 1; y++; }
      guard++;
    }
  }
  (pool.entries || []).forEach((e) => rows.push(e));
  rows.sort((a, b) => (a.date + a.id).localeCompare(b.date + b.id));
  let run = 0;
  return rows.map((r) => {
    const isIn = r.type === "topup" || r.type === "adjust-in";
    run += isIn ? r.amount : -r.amount;
    return {
      Date: r.date,
      Detail: r.desc,
      In: isIn ? r.amount : "",
      Out: !isIn ? r.amount : "",
      Balance: run,
    };
  });
}

function exportToExcel(workspaces) {
  const wb = XLSX.utils.book_new();
  const addSheet = (name, rows) => {
    // Excel sheet names max 31 chars, no special chars
    const safe = name.replace(/[\\/?*[\]:]/g, "").slice(0, 31);
    const ws = XLSX.utils.json_to_sheet(rows.length ? rows : [{ Note: "No data" }]);
    XLSX.utils.book_append_sheet(wb, ws, safe);
  };

  ["family", "personal"].forEach((wsId) => {
    const d = workspaces[wsId];
    if (!d) return;
    const tag = wsId === "family" ? "Fam" : "Pers";

    addSheet(`${tag} Transactions`, (d.transactions || []).map((t) => ({
      Date: t.date, Description: t.desc, Category: t.category, Card: t.method, Amount: t.amount,
    })));

    addSheet(`${tag} Budgets`, (d.categories || []).map((c) => ({
      Category: c, "Monthly Budget": Number(d.budgets?.[c]) || 0,
    })));

    addSheet(`${tag} Goals`, (d.goals || []).map((g) => ({
      Goal: g.name, Target: g.target, Saved: g.saved,
      "% Complete": g.target ? Math.round((g.saved / g.target) * 100) : 0,
      "Target Date": g.targetDate || "",
    })));

    addSheet(`${tag} Loans`, (d.loans || []).map((l) => ({
      Loan: l.name, Outstanding: l.balance, "Original Amount": l.original,
      "Monthly Installment": l.installment, "Rate % p.a.": l.rate,
      "Paid Down": (l.original || 0) - l.balance,
    })));

    const loanPayments = [];
    (d.loans || []).forEach((l) => (l.payments || []).forEach((p) => loanPayments.push({
      Loan: l.name, Date: p.date, Paid: p.amount, Interest: p.interest,
      Principal: p.principal, "Balance After": p.balanceAfter,
    })));
    addSheet(`${tag} Loan Payments`, loanPayments);

    addSheet(`${tag} Assets`, (d.assets || []).map((a) => ({ Asset: a.name, Type: a.type, Value: a.value })));
    addSheet(`${tag} Liabilities`, (d.liabilities || []).map((x) => ({ Liability: x.name, Balance: x.value })));

    addSheet(`${tag} Net Worth Trend`, (d.snapshots || []).map((s) => ({
      Month: s.month, Assets: s.assets, Liabilities: s.liabilities, "Net Worth": s.net,
    })));

    if (wsId === "family") {
      addSheet("Fam Pool Passbook", buildPoolLedger(d.pool));
    }
  });

  const stamp = new Date().toISOString().slice(0, 10);
  XLSX.writeFile(wb, `finance-hub-backup-${stamp}.xlsx`);
}

// ---------- Main App ----------
function FamilyFinanceHub() {
  const [workspaces, setWorkspaces] = useState({ family: makeDefault("family"), personal: makeDefault("personal") });
  const [activeWs, setActiveWs] = useState("family");
  const [loaded, setLoaded] = useState(false);
  const [saveState, setSaveState] = useState("idle"); // idle | saving | saved | error
  const [tab, setTab] = useState("dashboard");
  const [month, setMonth] = useState(thisMonth());

  const data = workspaces[activeWs];
  const wsMeta = WORKSPACES.find((w) => w.id === activeWs);

  // ----- Load from persistent storage -----
  useEffect(() => {
    (async () => {
      try {
        const raw = localStorage.getItem(STORAGE_KEY);
        if (raw) {
          const parsed = JSON.parse(raw);
          if (parsed && parsed.workspaces) {
            // New multi-workspace format
            setWorkspaces({
              family: { ...makeDefault("family"), ...parsed.workspaces.family },
              personal: { ...makeDefault("personal"), ...parsed.workspaces.personal },
            });
            if (parsed.activeWs) setActiveWs(parsed.activeWs);
          } else {
            // Migrate old single-ledger data into the Family workspace
            setWorkspaces((w) => ({ ...w, family: { ...makeDefault("family"), ...parsed } }));
          }
        }
      } catch (e) {
        // Key doesn't exist yet — first run, start fresh
      }
      setLoaded(true);
    })();
  }, []);

  // ----- Save on change -----
  useEffect(() => {
    if (!loaded) return;
    let cancelled = false;
    setSaveState("saving");
    const t = setTimeout(async () => {
      try {
        localStorage.setItem(STORAGE_KEY, JSON.stringify({ workspaces, activeWs }));
        if (!cancelled) setSaveState("saved");
      } catch (e) {
        if (!cancelled) setSaveState("error");
      }
    }, 500);
    return () => { cancelled = true; clearTimeout(t); };
  }, [workspaces, activeWs, loaded]);

  const update = useCallback((fn) => {
    setWorkspaces((all) => {
      const next = structuredClone(all);
      next[activeWs] = fn(next[activeWs]);
      return next;
    });
  }, [activeWs]);

  // ----- Derived -----
  const monthTx = useMemo(
    () => data.transactions.filter((t) => t.date && t.date.startsWith(month)),
    [data.transactions, month]
  );
  const monthTotal = monthTx.reduce((s, t) => s + t.amount, 0);
  const byCategory = useMemo(() => {
    const m = {};
    monthTx.forEach((t) => { m[t.category] = (m[t.category] || 0) + t.amount; });
    return m;
  }, [monthTx]);
  const byCard = useMemo(() => {
    const m = {};
    monthTx.forEach((t) => { m[t.method] = (m[t.method] || 0) + t.amount; });
    return m;
  }, [monthTx]);
  const budgetTotal = Object.values(data.budgets).reduce((s, v) => s + (Number(v) || 0), 0);
  const assetsTotal = data.assets.reduce((s, a) => s + a.value, 0);
  const liabTotal =
    data.liabilities.reduce((s, l) => s + l.value, 0) +
    (data.loans || []).reduce((s, l) => s + l.balance, 0);
  const netWorth = assetsTotal - liabTotal;

  const monthOptions = useMemo(() => {
    const set = new Set(data.transactions.map((t) => t.date && t.date.slice(0, 7)).filter(Boolean));
    set.add(thisMonth());
    set.add(month);
    return Array.from(set).sort().reverse();
  }, [data.transactions, month]);

  if (!loaded) {
    return (
      <div style={{ minHeight: "100vh", background: T.paper, display: "flex", alignItems: "center", justifyContent: "center", color: T.muted, fontFamily: "system-ui, sans-serif" }}>
        Opening your ledger…
      </div>
    );
  }

  const tabs = [
    { id: "dashboard", label: "Dashboard", icon: "layout-dashboard" },
    { id: "expenses", label: "Expenses", icon: "receipt-text" },
    { id: "budget", label: "Budget", icon: "wallet" },
    ...(activeWs === "family" ? [{ id: "pool", label: "Pool", icon: "banknote" }] : []),
    { id: "goals", label: "Goals", icon: "target" },
    { id: "networth", label: "Net Worth", icon: "landmark" },
  ];

  return (
    <div style={{ minHeight: "100vh", background: T.paper, fontFamily: "system-ui, -apple-system, sans-serif", color: T.ink }}>
      {/* Header */}
      <div style={{ background: wsMeta.accent, color: "#fff", padding: "18px 20px 0", transition: "background 0.3s ease" }}>
        <div style={{ maxWidth: 980, margin: "0 auto" }}>
          <div style={{ display: "flex", justifyContent: "space-between", alignItems: "flex-start", flexWrap: "wrap", gap: 8 }}>
            <div>
              <div style={{ fontSize: 11, letterSpacing: "0.12em", textTransform: "uppercase", opacity: 0.7, fontWeight: 600 }}>
                {wsMeta.eyebrow}
              </div>
              <div style={{ fontSize: 22, fontWeight: 700, marginTop: 2 }}>Finance Hub</div>
            </div>
            <div style={{ display: "flex", flexDirection: "column", alignItems: "flex-end", gap: 8 }}>
              {/* Workspace switcher */}
              <div style={{ display: "flex", background: "rgba(0,0,0,0.22)", borderRadius: 99, padding: 3 }}>
                {WORKSPACES.map((w) => (
                  <button
                    key={w.id}
                    onClick={() => { setActiveWs(w.id); setTab("dashboard"); setMonth(thisMonth()); }}
                    style={{
                      border: "none", cursor: "pointer", padding: "6px 16px", borderRadius: 99,
                      fontSize: 13, fontWeight: 700, transition: "all 0.2s ease",
                      background: activeWs === w.id ? "#fff" : "transparent",
                      color: activeWs === w.id ? w.accent : "rgba(255,255,255,0.8)",
                    }}
                  >
                    {w.label}
                  </button>
                ))}
              </div>
              <div style={{ display: "flex", alignItems: "center", gap: 10 }}>
                <button
                  onClick={() => exportToExcel(workspaces)}
                  style={{
                    display: "inline-flex", alignItems: "center", gap: 5, cursor: "pointer",
                    background: "rgba(255,255,255,0.14)", color: "#fff", border: "1px solid rgba(255,255,255,0.35)",
                    borderRadius: 7, padding: "5px 10px", fontSize: 12, fontWeight: 600,
                  }}
                  title="Download an Excel backup of both workspaces"
                >
                  <Icon name="download" size={13} /> Export Excel
                </button>
                <div style={{ fontSize: 12, opacity: 0.75, fontFamily: T.mono }}>
                  {saveState === "saving" && "Saving…"}
                  {saveState === "saved" && "✓ All changes saved"}
                  {saveState === "error" && "⚠ Save failed — retry by editing"}
                </div>
              </div>
            </div>
          </div>
          {/* Tabs */}
          <div style={{ display: "flex", gap: 4, marginTop: 16, overflowX: "auto" }}>
            {tabs.map(({ id, label, icon }) => (
              <button
                key={id}
                onClick={() => setTab(id)}
                style={{
                  display: "flex", alignItems: "center", gap: 6, padding: "10px 14px",
                  border: "none", cursor: "pointer", fontSize: 13.5, fontWeight: 600,
                  borderRadius: "8px 8px 0 0", whiteSpace: "nowrap",
                  background: tab === id ? T.paper : "rgba(255,255,255,0.06)",
                  color: tab === id ? wsMeta.accent : "rgba(255,255,255,0.85)",
                }}
              >
                <Icon name={icon} size={15} /> {label}
              </button>
            ))}
          </div>
        </div>
      </div>

      <div style={{ maxWidth: 980, margin: "0 auto", padding: "20px 16px 60px" }}>
        {tab === "dashboard" && (
          <Dashboard
            month={month} setMonth={setMonth} monthOptions={monthOptions}
            monthTotal={monthTotal} budgetTotal={budgetTotal} byCategory={byCategory}
            byCard={byCard} netWorth={netWorth} goals={data.goals} txCount={monthTx.length}
            budgets={data.budgets}
          />
        )}
        {tab === "expenses" && (
          <Expenses
            data={data} update={update} month={month} setMonth={setMonth}
            monthOptions={monthOptions} monthTx={monthTx} monthTotal={monthTotal}
          />
        )}
        {tab === "budget" && (
          <Budget data={data} update={update} month={month} setMonth={setMonth}
            monthOptions={monthOptions} byCategory={byCategory} />
        )}
        {tab === "goals" && <Goals data={data} update={update} />}
        {tab === "pool" && <Pool data={data} update={update} />}
        {tab === "networth" && (
          <NetWorth data={data} update={update} assetsTotal={assetsTotal}
            liabTotal={liabTotal} netWorth={netWorth} />
        )}
      </div>
    </div>
  );
}

// ---------- Month selector ----------
const MonthPicker = ({ month, setMonth, monthOptions }) => (
  <select
    value={month}
    onChange={(e) => setMonth(e.target.value)}
    style={{ ...inputStyle, width: "auto", fontWeight: 600, fontFamily: T.mono }}
  >
    {monthOptions.map((m) => (
      <option key={m} value={m}>{monthLabel(m)}</option>
    ))}
  </select>
);

// ---------- Dashboard ----------
function Dashboard({ month, setMonth, monthOptions, monthTotal, budgetTotal, byCategory, byCard, netWorth, goals, txCount, budgets }) {
  const overBudget = budgetTotal > 0 && monthTotal > budgetTotal;
  const pct = budgetTotal > 0 ? (monthTotal / budgetTotal) * 100 : 0;
  const topCats = Object.entries(byCategory).sort((a, b) => b[1] - a[1]).slice(0, 5);
  const maxCat = topCats.length ? topCats[0][1] : 1;

  return (
    <div style={{ display: "flex", flexDirection: "column", gap: 14 }}>
      <div style={{ display: "flex", justifyContent: "space-between", alignItems: "center", flexWrap: "wrap", gap: 8 }}>
        <Eyebrow>Overview — {monthLabel(month)}</Eyebrow>
        <MonthPicker month={month} setMonth={setMonth} monthOptions={monthOptions} />
      </div>

      <div style={{ display: "grid", gridTemplateColumns: "repeat(auto-fit, minmax(210px, 1fr))", gap: 12 }}>
        <Card>
          <Eyebrow>Spent this month</Eyebrow>
          <MonoNum size={26} color={overBudget ? T.red : T.ink}>{fmtRM(monthTotal)}</MonoNum>
          <div style={{ fontSize: 12.5, color: T.muted, marginTop: 4 }}>{txCount} transactions</div>
        </Card>
        <Card>
          <Eyebrow>Monthly budget</Eyebrow>
          <MonoNum size={26}>{budgetTotal > 0 ? fmtRM(budgetTotal) : "—"}</MonoNum>
          {budgetTotal > 0 ? (
            <div style={{ marginTop: 8 }}>
              <Bar pct={pct} over={overBudget} />
              <div style={{ fontSize: 12.5, color: overBudget ? T.red : T.muted, marginTop: 4, fontWeight: 600 }}>
                {overBudget
                  ? `Over by ${fmtRM(monthTotal - budgetTotal)}`
                  : `${fmtRM(budgetTotal - monthTotal)} remaining`}
              </div>
            </div>
          ) : (
            <div style={{ fontSize: 12.5, color: T.muted, marginTop: 4 }}>Set budgets in the Budget tab</div>
          )}
        </Card>
        <Card>
          <Eyebrow>Family net worth</Eyebrow>
          <MonoNum size={26} color={netWorth < 0 ? T.red : T.pineMid}>{fmtRM(netWorth)}</MonoNum>
          <div style={{ fontSize: 12.5, color: T.muted, marginTop: 4, display: "flex", alignItems: "center", gap: 4 }}>
            {netWorth >= 0 ? <Icon name="trending-up" size={13} /> : <Icon name="trending-down" size={13} />} assets minus liabilities
          </div>
        </Card>
      </div>

      <div style={{ display: "grid", gridTemplateColumns: "repeat(auto-fit, minmax(280px, 1fr))", gap: 12 }}>
        <Card>
          <Eyebrow>Top spending categories</Eyebrow>
          {topCats.length === 0 && <div style={{ color: T.muted, fontSize: 13.5, padding: "12px 0" }}>No transactions yet this month. Add some in the Expenses tab.</div>}
          {topCats.map(([cat, amt]) => {
